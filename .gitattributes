# Snapshots are checksummed in data_manifest.json, so git must store and check
# out their exact bytes (CRLF, as exported) instead of converting line endings.
data-local/snapshots/*.csv -text

# The frozen research packages verify these files by their exact byte hashes.
pre-v0/notebooks/whole_company_pilot.ipynb -text
pre-v0/experiments/whole_company_pilot/** -text
pre-v0/reports/whole_company_pilot/** -text
pre-v0/notebooks/integrated_company_analysis.ipynb -text
pre-v0/experiments/integrated_company_analysis/** -text
pre-v0/reports/integrated_company_analysis/** -text
pre-v0/notebooks/team_company_workflow.ipynb -text
pre-v0/reports/team_company_workflow/** -text
pre-v0/reports/team_company_workflow/*.pdf binary

# v1 outputs are shared through git (2026-11-04) and several are checked by their exact byte hashes
# (provenance files, saved prompts and answers), so store and check them out byte for byte on every OS.
outputs-local/v1/** -text
