# Local data and outputs. Shared through Git so the team has them:
# the input snapshots, and the current website text (one JSON per company).
# Raw HTML, page_text history, logs and other outputs stay local.
/data-local/*
!/data-local/snapshots/
/outputs-local/*
!/outputs-local/website_scrape/
/outputs-local/website_scrape/*
!/outputs-local/website_scrape/page_text/
!/outputs-local/website_scrape/scrape_log.csv

# v0 comps results are shared with the team BY DEFAULT: every outputs-local/comps*/
# folder (comps/, comps_pilot_targets/, and any later comps_<name>/) and every
# stage folder and file inside it, so a new stage or run needs no new line here.
# Only local-only material is ignored: directly under a stage folder, raw Codex
# output (codex_runs), run logs, dry-run prompts and *_history folders (local
# safety copies); a top-level history/ folder of superseded runs; and console
# logs. (fill_test/ and api_checks/ keep being shared whole, as before.)
!/outputs-local/comps*/
/outputs-local/comps*/history/
/outputs-local/comps*/*/codex_runs/
/outputs-local/comps*/*/logs/
/outputs-local/comps*/*/prompts_dry_run/
/outputs-local/comps*/*/*_history/
/outputs-local/comps*/**/*.log

# v1 results are shared the same way, BY DEFAULT (2026-11-04), so the team has the current data, comp lists,
# saved LLM answers and the golden-set sheets without asking: every outputs-local/v1/ folder and file, at any
# depth, except the same local-only material: raw Codex output (codex_runs), run logs, dry-run prompts,
# *_history safety copies, history/ folders of superseded runs, and console logs.
# (Pre-v0 folders, outputs-local/matching/ and outputs-local/scraps/, stay local.)
!/outputs-local/v1/
/outputs-local/v1/**/history/
/outputs-local/v1/**/codex_runs/
/outputs-local/v1/**/logs/
/outputs-local/v1/**/prompts_dry_run/
/outputs-local/v1/**/*_history/
/outputs-local/v1/**/*.log
/outputs-local/v1/facet_add_drop/cache/
/outputs-local/v1/facet_add_drop/pytest_tmp/
/outputs-local/v1/facet_add_drop/20*/

/.env

# Codex credentials must never be committed
auth.json
.codex/

__pycache__/
*.pyc

.venv/
.ipynb_checkpoints/

# Peer-evaluation CLI attempts and local analysis remain local.
/outputs-local/comps/peer_evaluation/
