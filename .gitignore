# Local data and outputs. Shared through Git so the team has them:
# the input snapshots, and the current website text (one JSON per company).
# Raw HTML, page_text history, logs and other outputs stay local.
/data-local/*
!/data-local/snapshots/
/outputs-local/*
!/outputs-local/website_scrape/
/outputs-local/website_scrape/*
!/outputs-local/website_scrape/page_text/
!/outputs-local/website_scrape/scrape_log.csv

# v0 comps results shared with the team: split, universe, valuation, facet
# profiles/tables, judge tables, and the candidates tables. Embeddings (can be
# regenerated), candidate rankings, run logs, prompts and history stay local.
!/outputs-local/comps/
/outputs-local/comps/*
!/outputs-local/comps/split/
!/outputs-local/comps/universe/
!/outputs-local/comps/valuation/
!/outputs-local/comps/facets/
/outputs-local/comps/facets/*
!/outputs-local/comps/facets/profiles/
!/outputs-local/comps/facets/tables/
!/outputs-local/comps/judge/
/outputs-local/comps/judge/*
!/outputs-local/comps/judge/tables/
!/outputs-local/comps/candidates/
/outputs-local/comps/candidates/*/ranking.csv.gz
/.env

# Codex credentials must never be committed
auth.json
.codex/

__pycache__/
*.pyc
