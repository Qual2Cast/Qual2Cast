    "EVIDENCE:TARGET": {
      "source": "outputs-local/website_scrape/page_text/IQ308299.json",
      "data": {
        "company_name": "THOR Industries, Inc.",
        "website": "www.thorindustries.com",
        "scrape_status": "ok",
        "capture_sha256": "e65e215f0ee109d281c467212fec948eb7849504a6bd5f3fb0b347539b9518f5",
        "lines": {
          "P1.1": {
            "text": "THOR Industries - Owner of Leading RV Manufacturers",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.2": {
            "text": "Discover the world of motorhomes and campers and let us help you find the perfect RV from our extensive list of brands including Airstream, Heartland RV, Jayco, and others.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.3": {
            "text": "we embarked on a journey to connect people with nature, and families with each other. Today, we continue that journey by leading a global family of companies that make it easier and more enjoyable for families of all types to create lasting outdoor memories. Together we can Go Everywhere; Stay Anywhere.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.4": {
            "text": "Meet the Family of Companies",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.5": {
            "text": "Together, the THOR family of companies represents the world’s largest manufacturer of recreational vehicles. We offer a comprehensive range of RVs and travel tools to inspire and empower everyone to Go Everywhere. Stay Anywhere. We’ve chosen our family wisely so your choice is that much easier.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.6": {
            "text": "We’ll help you figure out what kind of RV is right for you.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.7": {
            "text": "Travel trailers are the most popular type of non-motorized RV. They can be towed by a variety of vehicles and are made for a variety of uses, from hauling to vacationing to full-time RVing.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.8": {
            "text": "Many people think of toy haulers as the wild-child of the RV world, but these RVs have multi-purpose utlitity for every adventurer. The open \"garage\" can serve as storage for toys, an extra bedroom or even an on-the-go office.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.9": {
            "text": "Easy to hitch, easy to tow, and stable, fifth wheels offer plenty of comfort for the whole family. Versatility and space are the reasons why RVers choose fifth wheels for their trips — or for their full-time homes.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.10": {
            "text": "Built with the same framing and construction as commercial trucks and buses, Class A motorhomes are some of the largest vehicles on the road. AKA lots of room to stretch out and get comfortable.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.11": {
            "text": "Small, streamlined and ready to roll. Class B motorhomes (also known as camper vans) offer luxurious living space best suited for small groups.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.12": {
            "text": "Recognizable by their raised sleeping or storage areas which extend over the cab of the RV, Class C Motorhomes offer more living space than Class B Motorhomes but are smaller in size and can offer better gas mileage than Class A Motorcoaches.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.13": {
            "text": "Gear up for RV Buying Season",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.14": {
            "text": "The Best Time to Buy",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.15": {
            "text": "Learn how to take advantage of RV “Buying Season” and score excellent deals on your next dream RV.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.16": {
            "text": "Finding and Purchasing Our Next RV",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.17": {
            "text": "From RV shows to online research, explore the thoughtful steps these experienced RVers took in their journey to find their next RV.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.18": {
            "text": "Three Checklists To Help You Find Your Perfect RV",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.19": {
            "text": "Long-term RVers Ben and Christina McMillan share their three RV checklists to help guide you through the process.",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.20": {
            "text": "Trackside Service: Why Your Next RV Repair Might Be at the Racetrack",
            "url": "https://www.thorindustries.com/",
            "fetched_at": "2026-10-17T20:17:09Z"
          },
          "P1.21": {
            "text": "Discover how THOR Industries' complimentary mobile RV service transformed our NASCAR weekend.",
            "url": "https://www.thorindustries.com/",
